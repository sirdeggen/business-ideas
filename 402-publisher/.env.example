# Required: hex-encoded BSV private key (64 chars)
# Generate with: openssl rand -hex 32
PRIVATE_KEY=

# Optional: main or test
CHAIN=main

# Optional: wallet storage provider
STORAGE_URL=https://store-us-1.bsvb.tech

# Optional: satoshi prices (defaults shown)
HUMAN_SATS=100
CRAWLER_SATS=500

# Optional: listen port
PORT=3000
