{
  "name": "policy-treasury-feed",
  "version": "0.1.0",
  "private": true,
  "description": "Board activity feed for a 2-of-3 BSV policy treasury. Not a custodian.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "test": "tsx --test src/server.test.ts ../protocol/treasury.test.ts ../protocol/events.test.ts ../protocol/lookup.test.ts ../protocol/money.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bsv/sdk": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
