# Required: hex-encoded BSV private key (64 chars). Generate with: openssl rand -hex 32
SERVER_PRIVATE_KEY=

# Optional: main or test (default: main). Same values as 402-articles.
CHAIN=main

# Optional: wallet storage provider URL
STORAGE_URL=https://store-us-1.bsvb.tech

# Optional: satoshis charged per paid MCP tools/call (default: 10)
PRICE_SATS=10

# Optional: HTTP listen port (default: 3000)
PORT=3000

# Optional: bind address (default: 0.0.0.0 so Docker/cluster works)
HOST=0.0.0.0
