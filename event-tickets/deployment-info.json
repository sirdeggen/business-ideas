{
  "schema": "bsv-app",
  "schemaVersion": "1.0",
  "topicManagers": {
    "tm_tickets": "./overlay/src/tickets/TicketsTopicManager.ts"
  },
  "lookupServices": {
    "ls_tickets": {
      "serviceFactory": "./overlay/src/tickets/TicketsLookupServiceFactory.ts",
      "hydrateWith": "mongo"
    }
  },
  "frontend": {
    "language": "react",
    "sourceDirectory": "./frontend"
  },
  "configs": [
    {
      "name": "Local LARS",
      "network": "mainnet",
      "provider": "LARS",
      "run": ["backend", "frontend"]
    }
  ]
}
